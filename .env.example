# Пример переменных окружения. Скопировать в .env и заполнить своими значениями.
# .env в репозиторий не попадает — он в .gitignore.

# --- ЭЦП ---
# Пароль от ключа. Для продакшена вынести в защищённое хранилище,
# а не держать в файле на диске.
ECP_PASSWORD=
# Полный путь к файлу ключа .p12
ECP_KEY_PATH=
# Необязательно: часть ФИО владельца, если в хранилище несколько сертификатов
ECP_CERT_OWNER=

# --- Налогоплательщик ---
# ИИН (для ИП/физлица) или БИН (для юрлица)
KNP_TAXPAYER_CODE=
# IP или UL
KNP_TAXPAYER_TYPE=IP
# Код вида деятельности (ОКЭД)
KNP_OKED=
# Код органа государственных доходов по месту нахождения
KNP_OGD=
